{
  "name": "marketplace-api-contract",
  "version": "1.0.0",
  "private": true,
  "description": "Homework 09: OpenAPI contract for the Marketplace API + runtime validation at the boundary (option B), on NestJS",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "npm run build && node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "redocly lint openapi/openapi.yaml",
    "bundle": "redocly bundle openapi/openapi.yaml -o spec.json",
    "check": "node scripts/check-spec.js",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "check:env": "npm run build && node scripts/check-env-example.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "express": "4.22.2",
    "express-openapi-validator": "5.6.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@redocly/cli": "2.46.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}

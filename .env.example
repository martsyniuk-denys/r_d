# Runtime mode. One of: development | test | production.
NODE_ENV=development

# HTTP port the API listens on. Coerced from string to number by the schema.
PORT=3000

# Grader-style alternative to DB_URL + DB_PASSWORD_FILE: a full connection string
# with the password inside, as exported with SKIP_VAULT=1. Leave it empty when
# DB_URL is set; DB_URL wins when both are.
DATABASE_URL=

# Connection string WITHOUT a password: the password is a managed resource read
# from DB_PASSWORD_FILE, so it never appears in env or in git. The schema rejects
# this value if it contains a password component. The host and port are PgBouncer
# (compose publishes it on 56432), not Postgres itself — the application only ever
# talks to the pooler.
DB_URL=postgres://marketplace@localhost:56432/marketplace

# Path to the file holding the Postgres password. pg re-reads it for every new
# connection, which is what makes rotation without a restart possible.
DB_PASSWORD_FILE=./secrets/db_password

# Maximum number of connections in the pg pool.
DB_POOL_MAX=10

# How long to wait for a connection from the pool before failing, in ms.
DB_CONNECTION_TIMEOUT_MS=5000

# Application log level. One of: debug | info | warn | error.
LOG_LEVEL=info

# --- Tokens ---------------------------------------------------------------------
# The six variables below come from the secret store (secrets/jwt/<env>/, created
# by `node scripts/jwt-keys.mjs generate <env>`) through scripts/with-secrets.sh,
# and are left empty here on purpose: there is no default, and a bare
# `npm run start` without them exits 1 naming each one.

# ES256 signing key: base64 of a PKCS#8 PEM, EC P-256. Never written to a file in git.
JWT_PRIVATE_KEY=

# Its public half: base64 of an SPKI PEM. Must match JWT_PRIVATE_KEY.
JWT_PUBLIC_KEY=

# Key id written into every token header; the verifier picks the key by it.
JWT_KID=

# HMAC key for refresh_tokens.token_hash, at least 12 characters.
REFRESH_TOKEN_PEPPER=

# Overlap rotation only: the public key (base64 SPKI PEM) of the previous signing key.
JWT_PREVIOUS_PUBLIC_KEY=

# Overlap rotation only: the kid of that previous key. Set together with the key.
JWT_PREVIOUS_KID=

# iss claim written and required. Not a secret.
JWT_ISSUER=marketplace-api

# aud claim written and required. Not a secret.
JWT_AUDIENCE=marketplace-api

# Access-token lifetime in seconds (30–3600). Also the longest a demoted role or a
# stolen access token can outlive the change.
JWT_ACCESS_TTL_SECONDS=600

# Refresh-token lifetime in seconds (30 days).
REFRESH_TTL_SECONDS=2592000

# --- Not part of the application's env contract -------------------------------
# The broker address is read by the order.placed consumer and the three broker
# demos (src/messaging/broker.ts), not by the HTTP app, so it is absent from
# src/config/env.schema.ts. The URL carries no password; it lives in a file next
# to db_password (cp secrets/broker_password.example secrets/broker_password).
# Port 5672 is AMQP; 15672 is the management UI and does not speak the protocol.
#
#   BROKER_URL=amqp://marketplace@127.0.0.1:5672
#   BROKER_PASSWORD_FILE=./secrets/broker_password
#
# The two Redis instances are read by the Redis demos and src/pod.ts
# (src/redis/connection.ts), not by the Nest app. REDIS_URL is the cache
# (allkeys-lru, 56379); REDIS_QUEUE_URL is the queue instance (noeviction + AOF,
# 56380), which also holds sessions and rate-limit windows. The URLs carry no
# password (cp secrets/redis_password.example secrets/redis_password).
#
#   REDIS_URL=redis://127.0.0.1:56379
#   REDIS_QUEUE_URL=redis://127.0.0.1:56380
#   REDIS_PASSWORD_FILE=./secrets/redis_password
#
# The two variables below are read only by the contract tooling (scripts/pact-gate.sh
# and test/contract/provider.verify.test.ts), never by the app, so they are absent
# from src/config/env.schema.ts and stay commented out here. Locally they live in
# the store (.env, git-ignored) and arrive through scripts/with-secrets.sh; in CI
# they come from GitHub secrets. The local compose broker needs no token.
#
#   PACT_BROKER_URL=http://127.0.0.1:9292
#   PACT_BROKER_TOKEN=<from the secret store, never committed>

# --- Files -----------------------------------------------------------------------
# S3 API endpoint. Leave empty for AWS S3 itself; compose publishes RustFS on 59000.
STORAGE_ENDPOINT=http://127.0.0.1:59000

# Region the requests are signed for. Any value works for RustFS.
STORAGE_REGION=us-east-1

# The one bucket for uploads and published assets. Private: anonymous reads are 403.
STORAGE_BUCKET=marketplace-files

# Lifetime of a presigned single-PUT URL, seconds (1–3600). 300: an upload from a form
# starts right away, and a shorter URL is a smaller gift if it leaks into a log.
UPLOAD_PUT_TTL_SECONDS=300

# Access key id of the storage credential. Pairs with STORAGE_SECRET_KEY.
STORAGE_ACCESS_KEY=marketplace

# Comes from the secret store (secrets/storage_secret_key through
# STORAGE_SECRET_KEY_FILE and scripts/with-secrets.sh); empty here on purpose.
STORAGE_SECRET_KEY=

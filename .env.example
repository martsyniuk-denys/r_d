# Runtime mode. One of: development | test | production.
NODE_ENV=development

# HTTP port the API listens on. Coerced from string to number by the schema.
PORT=3000

# Connection string WITHOUT a password: the password is a managed resource read
# from DB_PASSWORD_FILE, so it never appears in env or in git. The schema rejects
# this value if it contains a password component. The host and port are PgBouncer
# (compose publishes it on 56432), not Postgres itself — the application only ever
# talks to the pooler.
DB_URL=postgres://marketplace@localhost:56432/marketplace

# Path to the file holding the Postgres password. pg re-reads it for every new
# connection, which is what makes rotation without a restart possible.
DB_PASSWORD_FILE=./secrets/db_password

# Maximum number of connections in the pg pool.
DB_POOL_MAX=10

# How long to wait for a connection from the pool before failing, in ms.
DB_CONNECTION_TIMEOUT_MS=5000

# Application log level. One of: debug | info | warn | error.
LOG_LEVEL=info

# --- Not part of the application's env contract -------------------------------
# The two variables below are read only by the contract tooling (scripts/pact-gate.sh
# and test/contract/provider.verify.test.ts), never by the app, so they are absent
# from src/config/env.schema.ts and stay commented out here. Locally they live in
# the store (.env, git-ignored) and arrive through scripts/with-secrets.sh; in CI
# they come from GitHub secrets. The local compose broker needs no token.
#
#   PACT_BROKER_URL=http://127.0.0.1:9292
#   PACT_BROKER_TOKEN=<from the secret store, never committed>
